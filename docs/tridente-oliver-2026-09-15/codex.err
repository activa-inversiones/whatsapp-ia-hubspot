   496: const ANTI_VOSEO = [
   497:   // verbos voseo mÃ¡s frecuentes
   498:   ["podÃ©s", "puede"],
   499:   ["tenÃ©s", "tiene"],
   500:   ["querÃ©s", "quiere"],
   501:   ["sabÃ©s", "sabe"],
   502:   ["venÃ­s", "viene"],
   503:   ["hacÃ©s", "hace"],
   504:   ["decÃ­s", "dice"],
   505:   ["ponÃ©s", "pone"],
   506:   ["sos", "es"],
   507:   // imperativos voseo
   508:   ["decime", "dÃ­game"],
   509:   ["contame", "cuÃ©nteme"],
   510:   ["mirÃ¡", "mire"],
   511:   ["cotizÃ¡", "cotice"],
   512:   ["avisame", "avÃ­seme"],
   513:   ["escribime", "escrÃ­bame"],
   514:   ["fijate", "fÃ­jese"],
   515:   ["dale", "adelante"],
   516:   // lÃ©xico rioplatense
   517:   ["bÃ¡rbaro", "excelente"],
   518:   ["laburo", "trabajo"],
   519:   ["vos", "usted"],
   520: ];
   521: 
   522: // [2026-06-19] Activa NO usa la palabra "cotizaciÃ³n" de cara al cliente: usa "propuesta"
   523: // (forma corta de "Propuesta TÃ©cnica EconÃ³mica", el nombre formal va en el PDF). Una regla en
   524: // el prompt NO basta (el LLM ve "cotizaciÃ³n" por todo el prompt como concepto y la copia), asÃ­
