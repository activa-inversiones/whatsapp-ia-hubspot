    71: /**
    72:  * LOS FOLIOS DE LAS OPCIONES, con su letra â€” reusando el sufijo que ya existe.
    73:  *
    74:  * âš ï¸ SE PIDE UN SOLO CORRELATIVO Y SE COMPONEN LAS TRES. Pedir tres `next-number` quemaria
    75:  * 0392/0393/0394 para un mismo cliente: auditable, pero contra la convencion ya acordada y
    76:  * contra el sentido del correlativo (un proyecto = un numero, las variantes son letras).
    77:  *
    78:  * âš ï¸ NO SE PUEDE USAR `numeroDeDocumento` EN BUCLE, y esa es la razon de que esta funcion
    79:  * exista: aquella es SECUENCIAL â€”exige `state.last_quote.pdf_sent === true` de un turno
    80:  * ANTERIORâ€” y dentro de una sola llamada a `generarPdf` el rastro recien se escribe al final.
    81:  * Las tres se asignan de una, aca, con las MISMAS letras.
    82:  *
    83:  * La letra del rotulo se deriva del FOLIO, no de la posicion: asi lo que el cliente lee en el
    84:  * mensaje ("opcion B") es literalmente el sufijo del archivo que recibe (`...-B.pdf`). Si el
    85:  * cliente ya se habia llevado alternativas antes, la terna sale B/C/D en vez de A/B/C â€” sigue
    86:  * identificando cada una sin ambiguedad y sin reusar una letra ya entregada, que en ISO es lo
    87:  * que de verdad importa.
    88:  *
    89:  * @param {string} quoteNumber  folio base ya obtenido (puede venir con letra)
    90:  * @param {number} cuantas      cuantas opciones se quieren (3)
    91:  * @param {number} usadasPrevias `state.last_quote.alternativas`
    92:  * @returns {Array<{numero:string, letra:string}>}
    93:  */
    94: export function foliosDeOpciones(quoteNumber, cuantas = 3, usadasPrevias = 0) {
    95:   const crudo = String(quoteNumber || '').trim();
    96:   if (!crudo) return [];
    97:   const base = crudo.replace(/-[A-Z]$/, '');
    98:   const letraActual = (crudo.match(/-([A-Z])$/) || [])[1] || '';
    99:   // Cuantas letras estan YA consumidas. Se toma el MAYOR entre el rastro de la sesion y lo
   100:   // que dice la propia letra: mismo criterio (y misma razon) que `alternativasEntregadas`.
   101:   let usadas = Math.max(
   102:     Number(usadasPrevias) || 0,
   103:     letraActual ? LETRAS_ALTERNATIVA.indexOf(letraActual) + 1 : 0,
   104:   );
   105:   const out = [{ numero: crudo, letra: letraActual || 'A' }];
   106:   const tope = Math.max(1, Number(cuantas) || 1);
   107:   for (let i = 1; i < tope; i++) {
   108:     // 26 alternativas para un mismo cliente no es un caso real; si pasa, se entregan las que
   109:     // alcancen en vez de inventar una numeracion que nadie sabria leer (mismo criterio que
   110:     // el 'sin_letras' de `numeroDeDocumento`).
   111:     if (usadas >= LETRAS_ALTERNATIVA.length) break;
   112:     out.push({ numero: `${base}-${LETRAS_ALTERNATIVA[usadas]}`, letra: LETRAS_ALTERNATIVA[usadas] });
   113:     usadas += 1;
   114:   }
   115:   return out;
   116: }
