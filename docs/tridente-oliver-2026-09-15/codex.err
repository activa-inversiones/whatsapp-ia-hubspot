  2044: // EnvÃ­o inteligente: texto, audio o ambos segÃºn VOICE_SEND_MODE
  2045: async function waSendSmartH(to, text, skipTyping = false, meta = {}) {
  2046:   const incomingType = meta.incomingType || "text";
  2047:   const sendVoice = shouldSendVoice(incomingType);
  2048:   const mode = VOICE_SEND_MODE;
  2049: 
  2050:   // Enviar texto siempre, excepto si el modo es "audio" (solo audio)
  2051:   if (!sendVoice || mode !== "audio") {
  2052:     await waSendH(to, text, skipTyping, meta);
  2053:   }
  2054: 
  2055:   if (sendVoice) {
  2056:     try {
  2057:       const { mime, ext } = elevenLabsMimeInfo();
  2058:       const audioBuf = await ttsElevenlabs(text);
  2059:       const mediaId = await waUploadAudio(audioBuf, mime, `reply_${Date.now()}.${ext}`);
  2060:       await waSendAudio(to, mediaId);
  2061:       logInfo("TTS", `audio enviado modo=${mode} provider=elevenlabs to=${to}`);
  2062:     } catch (e) {
  2063:       logErr("TTS", e);
  2064:       // Fallback: si el modo era "audio" y fallÃ³ TTS, enviar texto
  2065:       if (mode === "audio") {
  2066:         await waSendH(to, text, skipTyping, meta);
  2067:       }
  2068:     }
  2069:   }
  2070: }
  2071: 
  2072: // EnvÃ­o inteligente multi-burbuja: texto + un solo audio TTS con texto combinado
  2073: async function waSendSmartMultiH(to, msgs, skipTyping = false, meta = {}) {
  2074:   const incomingType = meta.incomingType || "text";
  2075:   const sendVoice = shouldSendVoice(incomingType);
  2076:   const mode = VOICE_SEND_MODE;
  2077: 
  2078:   // Enviar burbujas de texto siempre, excepto si el modo es "audio"
  2079:   if (!sendVoice || mode !== "audio") {
  2080:     await waSendMultiH(to, msgs, skipTyping, meta);
  2081:   }
  2082: 
  2083:   if (sendVoice) {
  2084:     const combined = msgs.filter(Boolean).join(". ");
  2085:     try {
  2086:       const { mime, ext } = elevenLabsMimeInfo();
  2087:       const audioBuf = await ttsElevenlabs(combined);
  2088:       const mediaId = await waUploadAudio(audioBuf, mime, `reply_${Date.now()}.${ext}`);
  2089:       await waSendAudio(to, mediaId);
  2090:       logInfo("TTS", `audio multi enviado modo=${mode} provider=elevenlabs to=${to}`);
  2091:     } catch (e) {
  2092:       logErr("TTS", e);
  2093:       // Fallback: si el modo era "audio" y fallÃ³ TTS, enviar texto
  2094:       if (mode === "audio") {
  2095:         await waSendMultiH(to, msgs, skipTyping, meta);
  2096:       }
  2097:     }
  2098:   }
  2099: }
