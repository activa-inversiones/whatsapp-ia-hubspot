    55: export function shouldSendVoice(userText = "", session = null, opts = {}) {
    56:   if (!voiceEnabled()) return false;
    57: 
    58:   // Si el cliente mandÃ³ audio, SIEMPRE responder con audio
    59:   const incomingType = opts?.incomingType || "text";
    60:   if (incomingType === "audio") return true;
    61: 
    62:   // Si el texto menciona "audio" / "nota de voz" / "voz"
