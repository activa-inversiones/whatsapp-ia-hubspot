   675: /**
   676:  * [2026-06-13] Normaliza la respuesta del motor a un unit_price DETERMINISTA (NETO).
   677:  * El motor devuelve varios campos de precio (total_clp neto, total_con_iva, precio_por_m2,
   678:  * subtotal). El PDF (services/quotePdf.js) AGREGA 19% IVA sobre la suma de unit_price, asÃ­
   679:  * que unit_price DEBE ser NETO (total_clp), igual que enginePricer.js (V1). Antes el LLM
   680:  * elegÃ­a el campo a ojo â†’ riesgo de DOBLE IVA (~19% de mÃ¡s) o precio/mÂ². Esto lo elimina:
   681:  * el LLM recibe un unit_price ya resuelto y solo lo copia a generar_pdf_cotizacion.
   682:  * @param {object} r - Respuesta cruda del motor.
   683:  * @param {number} [cantidad=1] - Cantidad cotizada (total_clp es el total de lÃ­nea).
   684:  * @returns {object} r + { unit_price, total_neto } o { ok:false, precio_invalido } si el total no sirve.
   685:  */
   686: export function conUnitPrice(r, cantidad = 1) {
   687:   if (!r || r.ok === false) return r;
   688:   const qty = Math.max(1, Number(cantidad) || 1);
   689:   // [FIX 2026-06-19 COB-02] saco total_con_iva del fallback: si el motor solo devuelve con IVA, usarlo como neto + 19% del PDF = doble IVA (~19% de mÃ¡s). Mejor escalar.
   690:   const lineTotal = Number(r.total_clp ?? r.total_neto_clp ?? 0);
   691:   if (!Number.isFinite(lineTotal) || lineTotal <= 0) {
   692:     return { ...r, ok: false, precio_invalido: true,
   693:       error: r.error || 'Total invÃ¡lido del motor; requiere revisiÃ³n de especialista (no cotizar a ciegas).' };
   694:   }
   695:   const unit_price = Math.round(lineTotal / qty);
   696:   return { ...r, unit_price, total_neto: lineTotal,
   697:     _nota_precio: 'unit_price es NETO (sin IVA). PÃ¡salo TAL CUAL a generar_pdf_cotizacion; el PDF agrega el 19% de IVA. NO uses total_con_iva ni precio_por_m2.' };
   698: }
   699: 
   700: async function falloDeCotizacion(r, item, ctx) {
   701:   const message = item?.price_warning || r?.error || 'No se pudo cotizar; lo revisa un especialista.';
   702:   const productoFueraDeAlcance =
   703:     r?.escalate === true && /^producto_fuera_de_alcance:/.test(String(r?.reason || ''));
   704: 
   705:   if (productoFueraDeAlcance && typeof ctx.notifyMarcelo === 'function') {
   706:     try {
   707:       await ctx.notifyMarcelo({
   708:         reason: `oliver_gpt:${r.reason}`,
   709:         data: { out_of_scope_category: r.category || '' },
   710:       });
   711:     } catch (err) {
   712:       console.error('[tools] escalaciÃ³n determinÃ­stica de producto fallÃ³:', err?.message || err);
   713:     }
   714:   }
   715: 
   716:   return {
   717:     ok: false,
   718:     precio_invalido: true,
   719:     requiere_revision: true,
   720:     error: message,
   721:     ...(productoFueraDeAlcance ? {
   722:       escalate: true,
   723:       reason: r.reason,
   724:       category: r.category,
   725:       message: r.customer_message || message,
   726:     } : {}),
   727:   };
   728: }
