    52: export function parseStatuses(body) {
    53:   // ðŸ”´ [Codex, revision final] TODAS las entradas y TODOS los changes. Meta puede mandar
    54:   // varios en un mismo webhook; leyendo solo `entry[0].changes[0]` se perdia un `failed`
