    83: async function synthesizeViaBridge({ text, waId = "", context = {} }) {
    84:   const res = await fetch(VOICE_TTS_URL, {
    85:     method: "POST",
    86:     headers: {
    87:       "Content-Type": "application/json",
    88:       ...(VOICE_TTS_TOKEN ? { Authorization: `Bearer ${VOICE_TTS_TOKEN}` } : {}),
    89:     },
    90:     body: JSON.stringify({
    91:       text,
    92:       voice_id: VOICE_TTS_VOICE_ID,
    93:       customer_id: waId,
    94:       context,
    95:       format: "ogg",
    96:     }),
    97:   });
    98: 
    99:   if (!res.ok) {
   100:     const err = await res.text().catch(() => "");
   101:     throw new Error(`TTS Bridge failed [${res.status}] ${err}`);
   102:   }
   103: 
   104:   const contentType = res.headers.get("content-type") || "";
   105: 
   106:   if (contentType.includes("application/json")) {
   107:     const data = await res.json();
   108: 
   109:     if (data.audio_base64) {
   110:       return {
   111:         buffer: Buffer.from(data.audio_base64, "base64"),
   112:         mime: data.mime || "audio/ogg",
   113:         filename: data.filename || "reply.ogg",
   114:       };
   115:     }
   116: 
   117:     if (data.audio_url) {
   118:       const audioRes = await fetch(data.audio_url);
   119:       if (!audioRes.ok) throw new Error(`TTS audio_url fetch failed [${audioRes.status}]`);
   120:       const arr = await audioRes.arrayBuffer();
   121:       return {
   122:         buffer: Buffer.from(arr),
   123:         mime: audioRes.headers.get("content-type") || "audio/ogg",
   124:         filename: "reply.ogg",
   125:       };
   126:     }
   127: 
   128:     throw new Error("TTS response missing audio payload");
   129:   }
   130: 
   131:   const arr = await res.arrayBuffer();
   132:   return {
   133:     buffer: Buffer.from(arr),
   134:     mime: contentType || "audio/ogg",
   135:     filename: "reply.ogg",
   136:   };
   137: }
