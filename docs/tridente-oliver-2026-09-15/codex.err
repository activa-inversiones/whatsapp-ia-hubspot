   925: // v11.3-3: DETECTOR DE NEGACIÃ“N pre-LLM.
   926: // Detecta patrones de negaciÃ³n/correcciÃ³n. Retorna { isNegation, negatedTerm }.
   927: function detectNegation(userText) {
   928:   if (!userText) return { isNegation: false, negatedTerm: null };
   929:   const t = String(userText).toLowerCase().trim();
   930: 
   931:   // Negaciones cortas standalone
   932:   const shortNegations = ["no", "no no", "no no no", "nop", "nah", "negativo", "nada"];
   933:   if (shortNegations.includes(t)) return { isNegation: true, negatedTerm: "general" };
   934: 
   935:   // Patterns: "sin X" / "X no" / "no quiero X" / "cambio a X" / "en realidad X"
   936:   const patterns = [
   937:     /^sin\s+(\w+)/,
   938:     /(\w+)\s+no$/,
   939:     /no\s+(quiero|me\s+sirve|es\s+eso)\s+(\w+)?/,
   940:     /cambio\s+a\s+(\w+)/,
   941:     /en\s+realidad\s+/,
   942:     /mejor\s+(\w+)/,
   943:     /no\s+(era|decÃ­a|decia)\s+/,
   944:   ];
   945: 
   946:   for (const p of patterns) {
   947:     const m = t.match(p);
   948:     if (m) return { isNegation: true, negatedTerm: m[1] || "general" };
   949:   }
   950: 
   951:   return { isNegation: false, negatedTerm: null };
   952: }
