   293:  * @param {string} texto              lo que escribio el cliente
   294:  * @param {string[]} letrasOfrecidas  las letras que el cliente tiene en la mano
   295:  */
   296: export function letraElegidaEnTexto(texto, letrasOfrecidas = []) {
   297:   const validas = new Set((Array.isArray(letrasOfrecidas) ? letrasOfrecidas : [])
