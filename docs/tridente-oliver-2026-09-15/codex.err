    45:         producto_label: t.result.producto_label || t.input?.tipo || 'Ventana',
    46:         measures: _res ? `${_res[1]}x${_res[2]}`
    47:           : (t.input?.medidas_texto || t.input?.measures || t.result?.medidas_derivadas ||
    48:             ((t.input?.ancho_mm && t.input?.alto_mm) ? `${t.input.ancho_mm}x${t.input.alto_mm}` : '')),
    49:         ancho_mm: _res ? Number(_res[1]) : undefined,
    50:         alto_mm: _res ? Number(_res[2]) : undefined,
    51:         color: t.input?.color || defaultColor || '',
    52:         qty: Number(t.result.cantidad) || Number(t.input?.cantidad) || 1,
    53:         unit_price: Number(t.result.unit_price) || 0,
