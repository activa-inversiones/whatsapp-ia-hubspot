   118: /**
   119:  * Cuantas letras quedan CONSUMIDAS tras reservar la terna. Se cuentan TODAS las reservadas,
   120:  * no solo las entregadas: si la B fallo y la C salio, la B NO se puede reciclar despues â€”
   121:  * habria dos documentos distintos con el mismo numero, que es exactamente el pisado del caso
   122:  * Paula. El hueco en la numeracion queda explicado en el log (en ISO un salto hay que poder
   123:  * explicarlo; una colision no se puede explicar de ninguna manera).
   124:  */
   125: export function letrasReservadas(opciones = []) {
   126:   return (Array.isArray(opciones) ? opciones : []).reduce((max, op) => {
   127:     const l = (String(op?.numero || '').match(/-([A-Z])$/) || [])[1];
   128:     return l ? Math.max(max, LETRAS_ALTERNATIVA.indexOf(l) + 1) : max;
   129:   }, 0);
   130: }
