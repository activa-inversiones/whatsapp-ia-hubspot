    64:   const explicit =
    65:     t.includes("audio") ||
    66:     t.includes("nota de voz") ||
    67:     t.includes("mensaje de voz") ||
    68:     t.includes("voz");
    69:   if (explicit) return true;
    70: 
    71:   // Modo "text_and_audio" = siempre audio (salvo si quiere PDF)
    72:   const wantsPdf = !!session?.data?.wants_pdf;
    73:   if (VOICE_SEND_MODE === "text_and_audio" && !wantsPdf) return true;
    74: 
    75:   // Modo "audio_if_inbound_audio" = solo si el inbound fue audio (ya cubierto arriba)
    76:   return false;
    77: }
