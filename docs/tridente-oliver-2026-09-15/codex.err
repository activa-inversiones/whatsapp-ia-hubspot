     1: // src/services/quoteCorrelativo.js
     2: // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
     3: // ACTIVA IMPERIUM â€” Correlativo ISO de cotizaciones (trazabilidad ISO 9001 Â§7.5)
     4: // â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
     5: // Genera un nÃºmero de cotizaciÃ³n SECUENCIAL y trazable (no aleatorio), formato
     6: // COT-AAAA-NNNN reiniciando cada aÃ±o. AtÃ³mico vÃ­a contador en Postgres:
     7: // dos turnos simultÃ¡neos NUNCA reciben el mismo nÃºmero (UPDATE ... RETURNING).
     8: //
     9: // Reemplaza el quote_number aleatorio del monolito (COT-fecha-XXXX) que NO
    10: // permitÃ­a auditar la secuencia (no se podÃ­a saber si faltaba una cotizaciÃ³n).
    11: //
    12: // Endpoint: POST /internal/quotes/next-number  â†’ { ok, quote_number, seq, year }
    13: // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
    14: 
    15: import { pool } from '../db/client.js';
    16: 
    17: const TENANT = process.env.DEFAULT_TENANT_ID || 'activa';
    18: // Correlativo ISO: el prefijo es el CÃ“DIGO del documento en el SGI (control documental).
    19: // CM-FR-004 = "CotizaciÃ³n / Propuesta Comercial" (Ã¡rea Comercial, registro). NO inventado:
    20: // dado de alta en el SGI con la nomenclatura ÃREA-TIPO-NNN del sistema. Override por env.
    21: const PREFIX = process.env.QUOTE_CORRELATIVO_PREFIX || 'CM-FR-004';
    22: 
    23: function log(m) { console.log(`[quoteCorrelativo] ${m}`); }
    24: 
    25: // MigraciÃ³n idempotente: tabla contador por (tenant, aÃ±o).
    26: async function ensureCounterTable() {
    27:   try {
    28:     await pool.query(`
    29:       CREATE TABLE IF NOT EXISTS quote_counters (
    30:         tenant_id text NOT NULL,
    31:         year      int  NOT NULL,
    32:         last_seq  int  NOT NULL DEFAULT 0,
    33:         updated_at timestamptz NOT NULL DEFAULT NOW(),
    34:         PRIMARY KEY (tenant_id, year)
    35:       )`);
    36:   } catch (e) { log(`ensureCounterTable: ${e.message}`); }
    37: }
    38: 
    39: /**
    40:  * Devuelve el SIGUIENTE correlativo de forma ATÃ“MICA. Concurrencia segura:
    41:  * el INSERT ... ON CONFLICT DO UPDATE ... RETURNING incrementa y devuelve en
    42:  * una sola sentencia (sin race conditions).
    43:  * @param {string} [tenantId]
    44:  * @returns {Promise<{ quote_number: string, seq: number, year: number }>}
    45:  */
    46: export async function nextQuoteNumber(tenantId = TENANT) {
    47:   const year = new Date().getFullYear();
    48:   const { rows } = await pool.query(
    49:     `INSERT INTO quote_counters (tenant_id, year, last_seq)
    50:        VALUES ($1, $2, 1)
    51:      ON CONFLICT (tenant_id, year)
    52:        DO UPDATE SET last_seq = quote_counters.last_seq + 1, updated_at = NOW()
    53:      RETURNING last_seq`,
    54:     [tenantId, year]
    55:   );
    56:   const seq = rows[0].last_seq;
    57:   const quote_number = `${PREFIX}-${year}-${String(seq).padStart(4, '0')}`;
    58:   return { quote_number, seq, year };
    59: }
    60: 
    61: // â”€â”€ Registro del endpoint interno (mismo patrÃ³n que registerAgendaRoutes) â”€â”€
    62: export function registerQuoteCorrelativo(app, { requireToken, requireAnyToken, operatorToken, operatorApiToken }) {
    63:   // El bot (cerebro) manda SALES_OS_OPERATOR_TOKEN. En sales-os ese valor puede
    64:   // coincidir con env.operatorToken O con env.operatorApiToken (sesiones usan este
    65:   // Ãºltimo y estÃ¡n probadas). Aceptar AMBOS garantiza que el correlativo ISO no
    66:   // caiga a fallback por un mismatch de token. // NO TOCA: dominio interno de confianza.
    67:   const validTokens = [operatorToken, operatorApiToken].filter(Boolean);
    68:   const auth = requireAnyToken
    69:     ? (req, res, next) => requireAnyToken(req, res, next, validTokens)
    70:     : (req, res, next) => requireToken(req, res, next, operatorToken);
    71:   ensureCounterTable().catch(e => log(`ensure arranque: ${e.message}`));
    72:   // El bot (cerebro GPT) pide el correlativo al generar el PDF de cotizaciÃ³n.
    73:   app.post('/internal/quotes/next-number', auth, async (req, res) => {
    74:     try {
    75:       const tenantId = (req.body && req.body.tenant_id) || TENANT;
    76:       const r = await nextQuoteNumber(tenantId);
    77:       // [2026-06-24] Adjuntar el descuento de mercado vigente â†’ el bot lo muestra en el
    78:       // PDF para que el CLIENTE lo vea (y el dueÃ±o confirme que estÃ¡ aplicado). El motor ya
    79:       // lo aplica a los precios; esto es solo para mostrarlo. try-catch: si falla, no rompe el correlativo.
    80:       let descuento_cliente_pct = 0;
    81:       try {
    82:         const dq = await pool.query(`SELECT value FROM activa_engine_config WHERE key='descuento_cliente_pct' LIMIT 1`);
    83:         if (dq.rows[0]) descuento_cliente_pct = Number(dq.rows[0].value) || 0;
    84:       } catch (e) { log(`descuento read: ${e.message}`); }
    85:       res.json({ ok: true, ...r, descuento_cliente_pct });
    86:     } catch (e) {
    87:       res.status(500).json({ ok: false, error: e.message });
    88:     }
    89:   });
    90: }

