   334:  *
   335:  * QUE **NO** LO CAMBIA: las medidas ni la cantidad de ventanas. Un proyecto de ocho ventanas
   336:  * es UN informe, y agregarle una novena no lo convierte en otro. Por eso las medidas no
   337:  * entran en la huella â€” si entraran, cada ventana nueva dispararia un informe.
   338:  */
   339: export function huellaDelInforme({ comuna = '', producto = '', glassLabel = '' } = {}) {
   340:   const norm = (v) => String(v || '')
   341:     .toLowerCase()
   342:     .normalize('NFD').replace(/[\u0300-\u036f]/g, '')   // "cunco" y "CuncÃ³" son la misma comuna
   343:     .replace(/[^a-z0-9]+/g, '')
   344:     .slice(0, 40);
   345:   const partes = [norm(comuna), norm(producto), norm(glassLabel)];
   346:   // Sin ningun dato la huella queda vacia: se cae al candado por telefono de siempre, que es
   347:   // el comportamiento viejo. Degradar al anterior es preferible a inventar una huella.
   348:   return partes.every((x) => !x) ? '' : partes.join('|');
   349: }
