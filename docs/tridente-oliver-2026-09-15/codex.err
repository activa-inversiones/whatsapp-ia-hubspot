  1865: // @patch:sales-os:send:start
  1866: async function waSendH(to, text, skipTyping = false, meta = {}) {
  1867:   // v11.3-4: SANITIZADOR UNIVERSAL â€” nunca JSON crudo ni URLs largas al cliente.
  1868:   const safeText = sanitizeForCustomer(text);
  1869:   const stop = skipTyping ? null : startTypingLoop(to);
  1870:   try {
  1871:     await sleep(humanMs(safeText));
  1872:     await waSend(to, safeText);
  1873:     if (meta.track !== false) {
  1874:       fireAndForget(
  1875:         "trackConversationEvent.outbound",
  1876:         trackConversationEvent({
  1877:           channel: "whatsapp",
  1878:           external_id: to,
  1879:           customer_name: meta.customer_name || "",
  1880:           direction: "outbound",
  1881:           actor_type: meta.actor_type || "assistant",
  1882:           actor_name: meta.actor_name || AGENT_NAME,
  1883:           message_type: meta.message_type || "text",
  1884:           body: safeText,
  1885:           metadata: meta.metadata || { source: "whatsapp_ia" },
  1886:           quote_status: meta.quote_status,
  1887:           unread_count: 0,
  1888:         })
  1889:       );
  1890:       // [v5.2] Marcar lead como respondido (idempotente, falla silenciosa)
  1891:       fireAndForget("markLeadResponded", markLeadResponded(to));
  1892:     }
  1893:   } finally {
  1894:     stop?.();
  1895:   }
  1896: }
  1897: 
  1898: // [v5.2] Marca first_response_at en sales-os via /internal/lead-responded/:phone
  1899: async function markLeadResponded(phone) {
  1900:   if (!SALES_OS_URL || !SALES_OS_OPERATOR_TOKEN) return;
  1901:   try {
  1902:     const ctrl = new AbortController();
  1903:     const timer = setTimeout(() => ctrl.abort(), 3000);
  1904:     // [FIX 2026-07-22] Mismo bug que en logOliverEvent: iba SOLO con x-internal-token y
  1905:     // sales-os lee el token de x-api-key / query.token / Bearer (utils/security.js:73-77).
  1906:     // Resultado: 401 en cada respuesta de Oliver â†’ first_response_at nunca se marcaba
  1907:     // (2 de 827 leads lo tienen) â†’ el motor de SLA avisaba de leads YA respondidos.
  1908:     // Es el mismo sÃ­ntoma que el "SLA fantasma" del 2026-07-06 (caso Jorge Rios, 14 alertas
  1909:     // con el PDF ya entregado): esa vez se arreglÃ³ el lado del servidor, pero el llamado
  1910:     // del bot seguÃ­a sin llegar. Se mandan los dos headers para no depender de uno solo.
  1911:     const r = await fetch(`${SALES_OS_URL}/internal/lead-responded/${encodeURIComponent(phone)}`, {
  1912:       method: "POST",
  1913:       headers: {
  1914:         "x-api-key": SALES_OS_OPERATOR_TOKEN,
  1915:         "x-internal-token": SALES_OS_OPERATOR_TOKEN,
  1916:       },
  1917:       signal: ctrl.signal,
  1918:     });
  1919:     clearTimeout(timer);
  1920:     // [FIX 2026-07-22] Antes esto era `catch {}` mudo y por eso el 401 pasÃ³ desapercibido
  1921:     // durante semanas. Un fallo silencioso se ve igual que un sistema sano: ahora grita.
  1922:     if (!r.ok) logErr("markLeadResponded", new Error(`sales-os respondiÃ³ ${r.status}`));
  1923:   } catch (e) {
  1924:     logErr("markLeadResponded", e);
  1925:   }
  1926: }
  1927: 
  1928: async function waSendMultiH(to, msgs, skipTyping = false, meta = {}) {
  1929:   const stop = skipTyping ? null : startTypingLoop(to);
  1930:   try {
  1931:     for (const m of msgs) {
  1932:       if (!m?.trim()) continue;
  1933:       await sleep(humanMs(m));
  1934:       await waSend(to, m);
  1935:       if (meta.track !== false) {
  1936:         fireAndForget(
  1937:           "trackConversationEvent.outbound_multi",
  1938:           trackConversationEvent({
  1939:             channel: "whatsapp",
  1940:             external_id: to,
  1941:             customer_name: meta.customer_name || "",
  1942:             direction: "outbound",
  1943:             actor_type: meta.actor_type || "assistant",
  1944:             actor_name: meta.actor_name || AGENT_NAME,
  1945:             message_type: meta.message_type || "text",
  1946:             body: m,
  1947:             metadata: meta.metadata || { source: "whatsapp_ia" },
  1948:             quote_status: meta.quote_status,
  1949:             unread_count: 0,
  1950:           })
  1951:         );
  1952:       }
  1953:       await sleep(250 + Math.random() * 450);
  1954:     }
  1955:   } finally {
  1956:     stop?.();
  1957:   }
  1958: }
