   258: /**
   259:  * EL COLOR DE CATALOGO AL QUE APUNTA UN TEXTO, o null si no apunta a ninguno.
   260:  *
   261:  * âš ï¸ NO se puede usar `normalizers.normColor` para esto: aquella DEVUELVE "BLANCO" cuando no
   262:  * reconoce nada (es un resolvedor para el motor, y ahi un default es lo correcto). Aca se
   263:  * necesita lo contrario â€” poder decir "no dijo ningun color" â€” porque el resultado decide si
   264:  * un pedido se trata como ELEGIR una propuesta ya entregada o como una cotizacion nueva. Con
   265:  * un default, cualquier texto sin color elegiria la opcion blanca por su cuenta.
   266:  *
   267:  * Devuelve la grafia que ve el cliente ("New Black", no "NEGRO"), que es con la que se
   268:  * guardaron las opciones y con la que se le habla.
   269:  */
   270: export function colorDeCatalogo(texto) {
   271:   const t = String(texto || '').toLowerCase().trim();
   272:   if (!t) return null;
   273:   if (/blanc/.test(t)) return 'Blanco';
   274:   // "roble dorado" antes que "nogal": las dos son de la familia madera y el orden decide.
   275:   if (/roble|dorad/.test(t)) return 'Roble Dorado';
   276:   if (/nogal|madera/.test(t)) return 'Nogal';
   277:   if (/grafito|antracita/.test(t)) return 'Grafito Antracita';
   278:   if (/negr|black/.test(t)) return 'New Black';
   279:   return null;
   280: }
