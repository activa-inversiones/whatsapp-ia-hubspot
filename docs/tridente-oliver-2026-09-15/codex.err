   982: // v11.5-2: DETECTOR DE AUDIOS ESPURIOS (TikTok forwards / audio bombing)
   983: // Estos audios contaminan la conversaciÃ³n. Patrones detectados en data real:
   984: // "amara.org", "subtÃ­tulos por la comunidad", "prÃ³ximo vÃ­deo", "mamÃ¡", "chao"
   985: // frases tÃ­picas de outros de YouTube/TikTok.
   986: const SPAM_AUDIO_PATTERNS = [
   987:   /amara\.org/i,
   988:   /subt[iÃ­]tulos.*comunidad/i,
   989:   /pr[oÃ³]ximo\s*v[iÃ­]deo/i,
   990:   /^Â¡?(mam[aÃ¡]|pap[aÃ¡]|chao|chau|hola)!?\.?$/i,
   991:   /hasta\s*la\s*pr[oÃ³]xima/i,
   992:   /nos\s*vemos\s*en\s*el\s*pr[oÃ³]ximo/i,
   993:   /^[Â¿?Â¡!\.\,\s]+$/,
   994: ];
   995: function detectSpamAudio(transcribedText) {
   996:   if (!transcribedText) return true; // audio sin transcripciÃ³n = sospechoso
   997:   const t = String(transcribedText).trim();
   998:   if (t.length < 4) return true; // muy corto = sospechoso
   999:   return SPAM_AUDIO_PATTERNS.some(p => p.test(t));
  1000: }
