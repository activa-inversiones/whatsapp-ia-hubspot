   299:   if (!validas.size) return null;
   300:   const t = String(texto || '');
   301:   if (!t.trim()) return null;
   302:   // Las palabras con las que la gente nombra una opcion en el chat. "numero" queda afuera a
   303:   // proposito: "el numero 0392-B" es un FOLIO, y ese caso lo resuelve el folio, no la letra.
   304:   const re = /\b(?:opci[oÃ³]n|alternativa|propuesta|la|el|con)\s+([a-z])\b/gi;
   305:   let m;
   306:   let hallada = null;
   307:   while ((m = re.exec(t)) !== null) {
   308:     const letra = m[1].toUpperCase();
   309:     if (!validas.has(letra)) continue;
   310:     // Dos letras distintas nombradas en el mismo mensaje ("entre la B y la C") NO es una
   311:     // eleccion: es una duda. Se devuelve null y contesta el cerebro, como hoy.
   312:     if (hallada && hallada !== letra) return null;
   313:     hallada = letra;
   314:   }
   315:   return hallada;
   316: }
   317: 
   318: /**
   319:  * Â¿ESTE PEDIDO ES *ELEGIR* UNA PROPUESTA QUE EL CLIENTE YA TIENE, O ES UNA COTIZACION NUEVA?
   320:  *
   321:  * ðŸŸ ðŸ’° [2026-08-31 Â· tridente, reproducido por Codex] ESTO TOCA PLATA. Sin esta pregunta, un
   322:  * "me quedo con la B" emitia OTRO documento (â€¦-D) y disparaba una SEGUNDA conversion 'sent'
   323:  * por un monto distinto. A Meta y a Google les llegaban DOS ventas cotizadas por UN cliente,
   324:  * y el algoritmo aprendia que ese trafico convierte el doble de lo que convierte: reparte el
   325:  * presupuesto del dueÃ±o con un dato falso. Elegir entre lo que ya se le mando NO es un
   326:  * negocio nuevo â€” es el MISMO negocio, decidido.
   327:  *
   328:  * Se responde que si solo cuando se cumplen TODAS:
   329:  *   1. la terna salio de verdad (hay 2 o mas opciones entregadas guardadas);
   330:  *   2. el rastro sigue vigente (la misma ventana de reuso que el folio: 48 h);
   331:  *   3. **es el MISMO proyecto**: misma lista de ventanas, mismas medidas, misma cantidad.
   332:  *      Sin esto, "me quedo con la B pero de 2 metros" se daria por elegida y el cliente se
   333:  *      quedaria con un documento que ya no dice lo que pidio;
   334:  *   4. apunta a una opcion concreta, por LETRA o por COLOR.
   335:  *
   336:  * âš ï¸ LA LETRA MANDA SOBRE EL COLOR, y no es un detalle de estilo. Cuando el cliente escribe
   337:  * "me quedo con la B", el modelo suele rellenar el color por defecto (Blanco) porque el
   338:  * system-prompt se lo ordena: si mandara el color, se daria por elegida la opcion BLANCA
   339:  * cuando el cliente pidio la NOGAL. La letra es lo que escribio el cliente; el color, en ese
   340:  * mensaje, es lo que rellenamos nosotros.
   341:  *
   342:  * @param {object}   o
   343:  * @param {object}   o.lastQuote    `state.last_quote` (trae `opciones` y `sig_proyecto`)
   344:  * @param {string}   o.texto        lo que escribio el cliente
   345:  * @param {string}   o.color        el color que trae el pedido (uno solo, o '' si son varios)
   346:  * @param {string}   o.sigProyecto  firma del proyecto de ESTE pedido (sin color ni precio)
   347:  * @param {number}   o.ventanaMs    cuanto vale el rastro
   348:  * @returns {{letra:string,color:string,numero:string,total:number}|null}
   349:  */
   350: export function opcionYaEntregada({ lastQuote, texto, color, sigProyecto, ventanaMs, ahora = Date.now() } = {}) {
   351:   const lq = lastQuote || {};
   352:   const ops = (Array.isArray(lq.opciones) ? lq.opciones : []).filter((o) => o && o.numero && o.color);
   353:   if (ops.length < 2) return null;
   354:   if (!(ahora - (Number(lq.at) || 0) < (Number(ventanaMs) || 0))) return null;
   355:   // El proyecto tiene que ser el MISMO. Si no hay firma guardada (rastro escrito por una
   356:   // version anterior), no se adivina: se devuelve al camino de siempre.
   357:   if (!sigProyecto || !lq.sig_proyecto || lq.sig_proyecto !== sigProyecto) return null;
   358: 
   359:   const porLetra = letraElegidaEnTexto(texto, ops.map((o) => o.letra));
   360:   if (porLetra) return ops.find((o) => String(o.letra).toUpperCase() === porLetra) || null;
   361: 
   362:   const buscado = colorDeCatalogo(color);
   363:   if (!buscado) return null;
   364:   return ops.find((o) => colorDeCatalogo(o.color) === buscado) || null;
   365: }

