   531: 
   532: export function sanitizeChilean(texto) {
   533:   if (!texto || typeof texto !== "string") return texto;
   534:   let out = texto;
   535:   for (const [from, to] of ANTI_VOSEO) {
   536:     // \b...\b con flags g+i, insensible a mayÃºsculas; preserva capitalizaciÃ³n
   537:     const re = new RegExp(`\\b${escapeRegExp(from)}\\b`, "giu");
   538:     out = out.replace(re, (match) => matchCase(match, to));
   539:   }
   540:   for (const [from, to] of TERM_REPLACEMENTS) {
   541:     const re = new RegExp(`\\b${escapeRegExp(from)}\\b`, "giu");
   542:     out = out.replace(re, (match) => matchCase(match, to));
   543:   }
   544:   return out;
   545: }
   546: 
   547: // Aplica al reemplazo la capitalizaciÃ³n del tÃ©rmino original encontrado.
   548: function matchCase(original, replacement) {
   549:   if (original === original.toUpperCase() && original.length > 1) {
   550:     return replacement.toUpperCase();
   551:   }
   552:   if (original[0] === original[0].toUpperCase()) {
   553:     return replacement[0].toUpperCase() + replacement.slice(1);
   554:   }
   555:   return replacement;
   556: }
