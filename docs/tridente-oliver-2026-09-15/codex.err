   954: // v11.3-4: SANITIZADOR UNIVERSAL. Hook en waSendH para eliminar basura del output.
   955: // Prohibido al cliente: JSON crudo, URLs largas tipo SharePoint, llaves/corchetes raros.
   956: function sanitizeForCustomer(text) {
   957:   if (!text || typeof text !== "string") return text;
   958:   let out = text;
   959: 
   960:   // 1. Eliminar bloques JSON crudos como [{"id":1,"product":...}]
   961:   out = out.replace(/\[\s*\{[^\[\]]*"(?:id|product|measures|qty|color|unit_price|total_price|source|confidence)"[^\[\]]*\}(?:\s*,\s*\{[^\[\]]*\})*\s*\]/gs, "[detalles en PDF]");
   962: 
   963:   // 2. Eliminar JSON objeto suelto con campos internos
   964:   out = out.replace(/\{\s*"(?:id|product|measures|unit_price|source|confidence)"[^\{\}]*\}/gs, "[detalles en PDF]");
   965: 
   966:   // 3. URLs SharePoint / Drive / Dropbox largas (>80 chars o con tokens)
   967:   out = out.replace(/https?:\/\/[^\s]*(?:sharepoint\.com|activaspacl-my\.sharepoint|dropbox|drive\.google)[^\s]*/g, "[video disponible â€” te lo envÃ­o en un momento]");
   968: 
   969:   // 4. URLs absurdamente largas genÃ©ricas (>150 chars de URL)
   970:   out = out.replace(/https?:\/\/[^\s]{150,}/g, "[link disponible â€” te lo paso aparte]");
   971: 
   972:   // 5. Tokens / IDs tÃ©cnicos expuestos
   973:   out = out.replace(/\b(?:wamid|estimate_id|deal_id|session_id)\s*[:=]\s*[A-Za-z0-9_\-]{10,}/gi, "");
   974: 
   975:   return out.trim();
   976: }
