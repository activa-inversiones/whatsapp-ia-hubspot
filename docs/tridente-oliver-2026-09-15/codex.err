   154: function sanitizeChilean(text) {
   155:   let result = text;
   156:   for (const [pattern, replacement] of Object.entries(ANTI_VOSEO)) {
   157:     result = result.replace(new RegExp(pattern, "gi"), replacement);
   158:   }
   159:   // Colapsa espacios dobles que dejan los reemplazos a "" (che/boludo).
   160:   return result.replace(/[ \t]{2,}/g, " ").replace(/ +([,.!?])/g, "$1");
   161: }
