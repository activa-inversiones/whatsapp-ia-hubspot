  281:  * @param {{botVersion?: string, timestamp?: string}} [opts]
  282:  */
  283: export async function logOliverEvent(eventType, payload = {}, opts = {}) {
  284:   if (!ingestEnabled()) return { ok: false, skipped: true };
  285:   if (!eventType || typeof eventType !== "string") {
  286:     return { ok: false, error: "event_type_required" };
  287:   }
  288:   return requestWithRetry("/internal/oliver-event/log", {
  289:     method: "POST",
  290:     body: {
  291:       event_type: eventType.slice(0, 80),
  292:       bot_version: opts.botVersion || process.env.BOT_VERSION || null,
  293:       timestamp: opts.timestamp || new Date().toISOString(),
  294:       payload: (payload && typeof payload === "object") ? payload : {},
  295:     },
  296:     token: SALES_OS_INGEST_TOKEN,
  297:     timeoutMs: TIMEOUT_INGEST_MS,
  298:   });
  299: }
