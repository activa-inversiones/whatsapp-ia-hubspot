   92:           out.push({ id: f.id, accion: ACCION.ALERTA_PENDING, fila: f,
   93:             motivo: `encolada hace ${Math.round(e / 60000)} min y nadie la tomÃ³` });
   94:         }
   95:         break;
   96:       }
   97:       case 'meta_accepted': {
   98:         const e = edad(f, ahora, 'meta_accepted_at');
   99:         if (Number.isFinite(e) && e >= sinAcuse) {
  100:           out.push({ id: f.id, accion: ACCION.ALERTA_SIN_ACUSE, fila: f,
  101:             motivo: `Meta la aceptÃ³ hace ${Math.round(e / 3600000)} h y nunca confirmÃ³ la entrega` });
  102:         }
  103:         break;
  104:       }
  105:       case 'failed':
  106:         out.push({ id: f.id, accion: ACCION.ALERTA_FALLIDO, fila: f,
  107:           motivo: `fallÃ³${f.intentos ? ` tras ${f.intentos} intento(s)` : ''}` });
  108:         break;
  109:       case 'dudoso': {
  110:         const e = edad(f, ahora, 'updated_at');
