   53: export function parseStatuses(body) {
   54:   // ðŸ”´ [Codex, revision final] TODAS las entradas y TODOS los changes. Meta puede mandar
   55:   // varios en un mismo webhook; leyendo solo `entry[0].changes[0]` se perdia un `failed`
   56:   // que viniera en la segunda â€” y ese candado no se libera nunca: el cliente queda 30 dias
   57:   // sin informe por un fallo que jamas vimos.
   58:   const lista = (Array.isArray(body?.entry) ? body.entry : [])
   59:     .flatMap((e) => (Array.isArray(e?.changes) ? e.changes : []))
   60:     .flatMap((c) => (Array.isArray(c?.value?.statuses) ? c.value.statuses : []));
   61:   if (!lista.length) return [];
   62:   return lista.reduce((salida, st) => {
   63:     // Sin id no se puede saber DE QUE mensaje habla: un acuse anonimo no sirve para nada
   64:     // y confundirlo con otro seria peor que ignorarlo.
   65:     if (!st || !st.id) return salida;
   66:     const err = Array.isArray(st.errors) ? st.errors[0] : null;
   67:     salida.push({
   68:       msgId: String(st.id),
   69:       estado: String(st.status || ''),
   70:       telefono: String(st.recipient_id || ''),
   71:       fallo: String(st.status || '') === 'failed',
   72:       codigo: err && Number.isFinite(Number(err.code)) ? Number(err.code) : null,
   73:       motivo: [err?.title, err?.message, err?.error_data?.details].filter(Boolean).join(' â€” '),
   74:     });
   75:     return salida;
   76:   }, []);
   77: }
