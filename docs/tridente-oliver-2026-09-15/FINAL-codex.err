    1: // webhook.acuses.test.js â€” [2026-08-24]
    2: //
    3: // QUE HACE EL BOT CON LOS ACUSES DE META. El parser ya los lee (whatsapp-acuses.test.js);
    4: // aca se prueba que sirvan para algo:
    5: //
    6: //   Â· un `failed` de un DOCUMENTO tiene que verse en la conversacion y avisarle a Marcelo,
    7: //     porque significa que el cliente NO tiene su propuesta o su informe;
    8: //   Â· si el que fallo era el informe termico, hay que SOLTAR el candado de 30 dias: si no,
    9: //     el cliente queda sin informe un mes por un envio que nunca llego;
   10: //   Â· un acuse nunca puede disparar un turno del bot ni contestarle nada al cliente.
   11: //
   12: // Nacio de un caso medido: un informe figuraba "entregado" en la base, con hora, y en el
   13: // WhatsApp del cliente no habia nada.
   14: 
   15: import test from 'node:test';
   16: import assert from 'node:assert/strict';
   17: import { handleWebhook } from './webhook.js';
   18: 
   19: function makeRes() {
   20:   return { sentStatus: undefined, sendStatus(c) { this.sentStatus = c; return this; } };
   21: }
   22: 
   23: const acuse = (status, msgId = 'wamid.DOC1', extra = {}) => ({
   24:   entry: [{ changes: [{ value: { statuses: [{
   25:     id: msgId, status, recipient_id: '56940415964', ...extra,
   26:   }] } }] }],
   27: });
   28: 
   29: function makeDeps({ enviado = null, overrides = {} } = {}) {
   30:   const spy = { convEvents: [], avisos: [], turnos: 0, borrados: [] };
   31:   const estado = new Map();
   32:   if (enviado) estado.set(`wamsg:${enviado.msgId}`, { valor: enviado, expira: null });
   33:   estado.set('informe_termico:56940415964', { valor: true, expira: null });
   34: 
   35:   const deps = {
   36:     conv: new Map(), seen: new Set(), locks: new Map(),
   37:     leerEstado: async (k) => (estado.has(k) ? estado.get(k).valor : null),
   38:     escribirEstado: (k, v) => estado.set(k, { valor: v, expira: null }),
   39:     borrarEstado: (k) => { spy.borrados.push(k); estado.delete(k); },
   40:     handleTurn: async () => { spy.turnos += 1; return { reply: 'x', history: [], toolCalls: [], state: {} }; },
   41:     sendWhatsAppText: async () => ({ ok: true, msgId: 'm1' }),
   42:     notifyHighValue: async (...a) => { spy.avisos.push(a); return { sent: true }; },
   43:     bridge: {
   44:       getConversationControl: async () => ({ ai_paused: false, operator_status: 'ai' }),
   45:       pushConversationEvent: async (p) => { spy.convEvents.push(p); return { ok: true }; },
   46:       pushLeadEvent: async () => ({ ok: true }),
   47:       pushQuoteEvent: async () => ({ ok: true }),
   48:     },
   49:     _estado: estado,
   50:   };
   51:   Object.assign(deps, overrides);
   52:   return { deps, spy };
   53: }
   54: 
   55: test('ðŸ”’ un acuse NO despierta al bot ni le contesta al cliente', async () => {
   56:   const { deps, spy } = makeDeps();
   57:   const res = makeRes();
   58:   await handleWebhook({ body: acuse('delivered') }, res, deps);
   59:   assert.equal(res.sentStatus, 200, 'igual se ackea a Meta');
   60:   assert.equal(spy.turnos, 0, 'un acuse no es un mensaje del cliente');
   61: });
   62: 
   63: test('ðŸ”´ un documento que FALLA se ve en la conversacion', async () => {
   64:   // Sin esto, el operador ve "propuesta enviada" y el cliente no tiene nada: la version
   65:   // del sistema y la realidad se separan y nadie se entera.
   66:   const { deps, spy } = makeDeps({
   67:     enviado: { msgId: 'wamid.DOC1', tipo: 'informe_termico', folio: 'CM-FR-006-2026-0005', telefono: '56940415964' },
   68:   });
