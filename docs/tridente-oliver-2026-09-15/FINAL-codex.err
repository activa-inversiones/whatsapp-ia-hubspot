   63: export function decidir(filas, ahora = Date.now(), opts = {}) {
   64:   if (!Array.isArray(filas)) return [];
   65:   const lease = opts.leaseMs ?? LEASE_MS;
   66:   const piso = opts.edadMinimaMs ?? EDAD_MINIMA_MS;
   67:   const pendingViejo = opts.pendingViejoMs ?? PENDING_VIEJO_MS;
   68:   const sinAcuse = opts.sinAcuseMs ?? SIN_ACUSE_MS;
