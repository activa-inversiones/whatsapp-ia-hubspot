   36: function log(m) { console.log(`[entregaVigilante] ${m}`); }
   37: 
   38: /**
   39:  * Trae solo lo que puede necesitar atenciÃ³n. El `LIMIT` evita que una acumulaciÃ³n
   40:  * histÃ³rica convierta una pasada en un barrido de toda la tabla.
   41:  */
   42: async function filasARevisar(tenantId) {
   43:   // ðŸ”´ [Kimi, compuerta] LA HORA SALE DE LA BASE, NO DEL PROCESO. Las edades se
   44:   // comparaban con `Date.now()` del contenedor contra timestamps de Postgres: con el
   45:   // reloj corrido (NTP caÃ­do, contenedor mal configurado) la edad se infla y el
   46:   // vigilante puede marcar `dudoso` algo que TODAVÃA estÃ¡ en vuelo â€” que es justo el
   47:   // camino por el que el humano termina duplicando.
   48:   const { rows } = await pool.query(
   49:     `SELECT id, estado, folio, phone, intentos, created_at, claimed_at,
   50:             meta_accepted_at, updated_at, alertado_at,
   51:             EXTRACT(EPOCH FROM NOW()) * 1000 AS _ahora_db
   52:        FROM entrega_outbox
   53:       WHERE tenant_id = $1
   54:         AND estado IN ('pending','claimed','meta_accepted','failed','dudoso')
   55:       ORDER BY created_at ASC
   56:       LIMIT 200`,
   57:     [tenantId]
   58:   );
   59:   return rows;
   60: }
   61: 
   62: /**
   63:  * Cruza los acuses de entrega que registrÃ³ el bot contra las filas del outbox.
   64:  *
   65:  * Los eventos `documento_entregado` los escribe el bot al recibir el acuse de Meta
   66:  * (Fase 0.2, webhook.js). AcÃ¡ solo se leen y se arbitran.
   67:  *
   68:  * âš ï¸ LÃMITE CONOCIDO: hoy el bot solo registra los acuses de ENTREGA. Los de FALLO
   69:  * los maneja por su cuenta (avisa a Marcelo, suelta candados) pero NO deja evento,
   70:  * asÃ­ que el veredicto A_FALLIDO del Ã¡rbitro todavÃ­a no puede dispararse desde acÃ¡.
   71:  * Queda como pendiente: sin eso, un mensaje que Meta rechazÃ³ deja su fila colgada.
   72:  *
   73:  * @returns {Promise<{cerradas: number, textos: string[]}>}
   74:  */
   75: async function arbitrarAcuses(tenantId, filas, ahoraDb) {
   76:   const out = { cerradas: 0, textos: [] };
   77:   if (!filas.length) return out;
   78: 
   79:   const { rows: acuses } = await pool.query(
   80:     `SELECT phone, event_at, payload->>'wamid' AS wamid
   81:        FROM oliver_events
   82:       WHERE tenant_id = $1 AND event_type = 'documento_entregado'
   83:         AND event_at > NOW() - INTERVAL '24 hours'
   84:       ORDER BY event_at DESC
   85:       LIMIT 500`,
   86:     [tenantId]
   87:   );
   88: 
   89:   for (const ac of acuses) {
   90:     const r = arbitrar({ estado: 'delivered', wamid: ac.wamid, phone: ac.phone, at: ac.event_at }, filas);
   91: 
   92:     if (r.veredicto === VEREDICTO.CERRAR) {
   93:       // Guarda de estado: solo cierra si la fila sigue donde el Ã¡rbitro la vio.
   94:       const { rowCount } = await pool.query(
   95:         `UPDATE entrega_outbox SET estado='delivered', delivered_at=NOW()
   96:           WHERE id=$1 AND estado IN ('claimed','meta_accepted','dudoso')`,
   97:         [r.id]
   98:       );
   99:       if (rowCount) out.cerradas++;
  100:     } else if (r.veredicto === VEREDICTO.CONTRADICCION) {
  101:       // No se cierra en silencio: Meta dijo una cosa y despuÃ©s la contraria.
  102:       log(`ðŸ”´ contradicciÃ³n en ${r.id}: ${r.motivo}`);
  103:     } else if (r.veredicto === VEREDICTO.EVIDENCIA) {
  104:       const t = textoEvidencia(r);
  105:       if (t && !out.textos.includes(t)) out.textos.push(t);
  106:     }
  107:   }
  108:   if (out.cerradas) log(`el acuse de Meta cerrÃ³ ${out.cerradas} caso(s) sin molestar al dueÃ±o`);
  109:   return out;
  110: }
  111: 
  112: /**
  113:  * Una pasada. Devuelve lo que hizo, para que el llamador pueda loguear o testear.
  114:  * @param {{tenantId?: string, avisar?: (texto: string) => Promise<any>}} [opts]
  115:  */
  116: export async function pasada(opts = {}) {
  117:   if (!outboxEnabled()) return { ok: false, skipped: true };
  118:   const tenantId = opts.tenantId || process.env.DEFAULT_TENANT_ID || 'activa';
  119: 
  120:   // ðŸ”´ [Kimi, compuerta] CANDADO ENTRE INSTANCIAS. `_corriendo` solo protege dentro de
  121:   // UN proceso; con dos instancias, las dos calculan el mismo snapshot y le mandan al
  122:   // dueÃ±o el MISMO aviso dos veces. No duplica al cliente, pero entrena al dueÃ±o a
  123:   // ignorar los avisos â€” y la defensa contra el duplicado residual es justamente que
  124:   // los lea. `pg_try_advisory_lock` no espera: si otra instancia lo tiene, se saltea.
  125:   const { rows: _lk } = await pool.query('SELECT pg_try_advisory_lock($1) AS tomado', [778001]);
  126:   if (!_lk[0]?.tomado) return { ok: true, skipped: true, motivo: 'otra_instancia' };
  127: 
  128:   try {
  129:   const filas = await filasARevisar(tenantId);
  130:   const ahoraDb = Number(filas[0]?._ahora_db) || Date.now();
  131: 
  132:   // â”€â”€ ÃRBITRO (Fase 3) â€” PRIMERO, antes de decidir nada â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  133:   // Lo que Meta ya confirmÃ³ no tiene que llegar a la lista del dueÃ±o: cada revisiÃ³n
  134:   // manual que se evita es una chance menos de que alguien reenvÃ­e por las dudas.
  135:   const pistas = await arbitrarAcuses(tenantId, filas, ahoraDb);
  136: 
  137:   // Se vuelve a leer SOLO si el Ã¡rbitro cerrÃ³ algo: las filas en memoria quedaron
  138:   // viejas y decidir sobre ellas mandarÃ­a a `dudoso` una entrega ya confirmada.
  139:   const filasVigentes = pistas.cerradas ? await filasARevisar(tenantId) : filas;
  140:   const decisiones = decidir(filasVigentes, ahoraDb);
  141:   if (!decisiones.length) return { ok: true, revisadas: filas.length, acciones: 0 };
  142: 
  143:   let marcadas = 0;
  144:   for (const d of decisiones) {
  145:     if (d.accion !== ACCION.A_DUDOSO) continue;
  146:     // Guarda de estado: si otro proceso ya la moviÃ³, este UPDATE no toca nada.
  147:     // Mismo criterio que el claim â€” la fila solo cambia si sigue donde la vimos.
  148:     const { rowCount } = await pool.query(
  149:       `UPDATE entrega_outbox
  150:           SET estado='dudoso', last_error=$2
  151:         WHERE id=$1 AND estado='claimed'`,
  152:       [d.id, `vigilante: ${d.motivo}`]
  153:     );
  154:     if (rowCount) marcadas++;
  155:   }
  156: 
  157:   // ðŸ”´ [Kimi, compuerta] THROTTLE. Sin esto, un `failed` olvidado generaba un aviso CADA
  158:   // PASADA: 1.440 mensajes al dÃ­a. Solo se avisa de una fila si nunca se avisÃ³ o si pasÃ³
  159:   // el intervalo. Es el cambio mÃ¡s importante de esta revisiÃ³n, porque la defensa contra
  160:   // el duplicado residual es que el dueÃ±o LEA el aviso.
  161:   const nuevas = filtrarYaAvisadas(decisiones, ahoraDb, AVISO_REPETIR_MS);
  162: 
  163:   let texto = mensaje(nuevas);
  164:   // Las pistas del Ã¡rbitro viajan PEGADAS al aviso: el dueÃ±o resuelve mirando el chat,
  165:   // y una pista que llega en otro mensaje â€”o peor, que no llegaâ€” no le sirve de nada.
  166:   if (texto && pistas.textos.length) texto = [texto, '', ...pistas.textos].join('\n');
  167:   if (texto && typeof opts.avisar === 'function') {
  168:     // El aviso NUNCA puede voltear la pasada: lo importante ya quedÃ³ escrito en la BD.
  169:     // Solo se marca `alertado_at` si el aviso SALIÃ“: si el canal estÃ¡ caÃ­do, la prÃ³xima
  170:     // pasada lo reintenta en vez de darlo por avisado en silencio.
  171:     try {
  172:       await opts.avisar(texto);
  173:       await pool.query(
  174:         `UPDATE entrega_outbox SET alertado_at = NOW() WHERE id = ANY($1::uuid[])`,
  175:         [nuevas.map((d) => d.id)]
  176:       );
  177:     } catch (e) {
  178:       log(`ðŸ”´ aviso NO saliÃ³ (${e.message}) â€” ${nuevas.length} caso(s) quedan sin avisar`);
  179:     }
  180:   }
  181: 
  182:   log(`revisadas=${filas.length} cerradas_por_acuse=${pistas.cerradas} decisiones=${decisiones.length} nuevas=${nuevas.length} marcadas_dudoso=${marcadas}`);
  183:   return { ok: true, revisadas: filas.length, cerradas: pistas.cerradas,
  184:     acciones: decisiones.length, nuevas: nuevas.length, marcadas, texto };
  185:   } finally {
  186:     await pool.query('SELECT pg_advisory_unlock($1)', [778001]).catch(() => {});
  187:   }
  188: }
  189: 
  190: /** Arranca el vigilante. No hace nada si el flag estÃ¡ apagado. */
  191: export function startVigilante(opts = {}) {
  192:   if (!outboxEnabled()) {
  193:     log('OUTBOX_ENABLED apagado â€” el vigilante NO se agenda');
  194:     return { ok: false, skipped: true };
  195:   }
  196:   if (_timer) return { ok: true, yaCorriendo: true };
  197: 
  198:   _timer = setInterval(async () => {
  199:     // ðŸ”´ La guarda de solape. Si la pasada anterior todavÃ­a corre, esta se saltea:
  200:     // dos vigilantes marcando `dudoso` la misma fila en paralelo es el escenario que
  201:     // le fabrica al dueÃ±o una decisiÃ³n de reenvÃ­o que puede duplicar.
  202:     if (_corriendo) { log('pasada anterior sigue corriendo â€” se saltea este ciclo'); return; }
  203:     _corriendo = true;
  204:     try { await pasada(opts); }
  205:     catch (e) { log(`pasada fallÃ³: ${e.message}`); }
  206:     finally { _corriendo = false; }
  207:   }, INTERVALO_MS);
  208: 
  209:   if (typeof _timer.unref === 'function') _timer.unref();
  210:   log(`agendado cada ${Math.round(INTERVALO_MS / 1000)} s (lease ${LEASE_MS / 1000} s, piso ${EDAD_MINIMA_MS / 1000} s)`);
  211:   return { ok: true };
  212: }
  213: 
  214: /** Para tests y apagado ordenado. */
  215: export function stopVigilante() {
  216:   if (_timer) { clearInterval(_timer); _timer = null; }
  217:   _corriendo = false;
  218: }
  219: 
  220: export default { startVigilante, stopVigilante, pasada };

