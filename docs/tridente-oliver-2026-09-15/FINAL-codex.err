   81:         // Una fila reciÃ©n reclamada puede tener el envÃ­o todavÃ­a en vuelo, y marcarla
   82:         // dudoso es fabricarle al dueÃ±o una decisiÃ³n de reenvÃ­o que puede duplicar.
   83:         if (e < piso) break;
   84:         if (e < lease) break;
   85:         out.push({ id: f.id, accion: ACCION.A_DUDOSO, fila: f,
   86:           motivo: `sin cerrar hace ${Math.round(e / 60000)} min` });
   87:         break;
   88:       }
   89:       case 'pending': {
   90:         const e = edad(f, ahora, 'created_at');
