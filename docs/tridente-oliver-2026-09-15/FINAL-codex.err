  145:     }
  146:     lineas.push('', 'AbrÃ­ el chat del cliente y fijate si el documento estÃ¡. NO se reenvÃ­a solo.');
  147:   }
  148: 
  149:   if (otros.length) {
  150:     if (lineas.length) lineas.push('');
  151:     lineas.push(`ðŸ”Ž AdemÃ¡s: ${otros.length} caso(s) para revisar.`);
  152:     for (const d of otros.slice(0, 5)) {
  153:       lineas.push(`â€¢ ${d.fila?.folio || d.id} â€” ${d.motivo}`);
  154:     }
  155:   }
  156: 
  157:   return lineas.join('\n');
  158: }
