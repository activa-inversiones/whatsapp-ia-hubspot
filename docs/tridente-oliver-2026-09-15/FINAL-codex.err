  229:       WHERE id=$1 AND estado='claimed' AND instance_id=$2 AND intentos=$3
  230:       RETURNING *`,
  231:     [id, instanceId, intentos, estado, wamid, error]
  232:   );
  233:   return rows[0] || null;
  234: }
