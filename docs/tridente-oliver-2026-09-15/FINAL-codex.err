  180: /**
  181:  * Convierte un error de axios en el contrato que consume `errorMeta.clasificar()`.
  182:  * NO decide nada: solo preserva lo que hoy se perdÃ­a.
  183:  *
  184:  * @param {string} etiqueta  para el log
  185:  * @param {string} to        destinatario (solo para el log)
  186:  * @param {any} err          el error de axios
  187:  * @returns {{ok:false, error:string, status?:number, code?:number,
  188:  *            error_subcode?:number, timedOut:boolean, netCode?:string}}
  189:  */
  190: function errorEstructurado(etiqueta, to, err) {
  191:   const data = err?.response?.data;
  192:   const metaErr = data?.error || {};
  193:   // axios marca el timeout como ECONNABORTED; tambiÃ©n hay implementaciones que usan ETIMEDOUT.
  194:   const timedOut = err?.code === "ECONNABORTED" || err?.code === "ETIMEDOUT" ||
  195:     /timeout/i.test(String(err?.message || ""));
  196:   const texto = data ? JSON.stringify(data) : String(err?.message || "error_desconocido");
  197: 
  198:   const out = {
  199:     ok: false,
  200:     error: texto,                                  // compatibilidad: forma de siempre
  201:     status: err?.response?.status,                 // NUNCA se capturaba antes
  202:     code: Number.isFinite(metaErr.code) ? metaErr.code : undefined,
  203:     error_subcode: Number.isFinite(metaErr.error_subcode) ? metaErr.error_subcode : undefined,
  204:     timedOut,
  205:     netCode: err?.code,
  206:   };
  207:   console.error(
  208:     `[wa-adapter] ${etiqueta}: to=${to} status=${out.status ?? "-"} code=${out.code ?? "-"} ` +
  209:     `subcode=${out.error_subcode ?? "-"} timeout=${timedOut} net=${out.netCode ?? "-"} :: ${texto.slice(0, 300)}`
  210:   );
  211:   return out;
  212: }
