  149:   deps._estado.set('wamsg:wamid.NUEVO', { valor: { msgId: 'wamid.NUEVO', tipo: 'informe_termico', folio: 'F-B', telefono: '56940415964' }, expira: null });
  150:   deps._estado.set('informe_termico:56940415964:ultimo_msg', { valor: 'wamid.NUEVO', expira: null });
  151: 
  152:   await handleWebhook({ body: acuse('failed', 'wamid.VIEJO') }, makeRes(), deps);
  153:   await new Promise((r) => setTimeout(r, 80));
  154:   assert.ok(!spy.borrados.includes('informe_termico:56940415964'),
  155:     'el acuse de un envio que ya fue reemplazado no toca el candado del vigente');
  156: });
