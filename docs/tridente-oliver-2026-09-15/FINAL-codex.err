   28: // â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
   29: 
   30: export const VERSION = '1.0.0';
   31: 
   32: /** Ventana para considerar que un acuse desconocido PUEDE ser de un caso dudoso. */
   33: export const VENTANA_EVIDENCIA_MS = 30 * 60_000; // 30 min
   34: 
   35: export const VEREDICTO = {
   36:   CERRAR: 'cerrar',              // wamid exacto + acuse positivo â‡’ entregado
   37:   A_FALLIDO: 'a_fallido',        // wamid exacto + Meta dice que fallÃ³
   38:   CONTRADICCION: 'contradiccion', // el acuse no cuadra con el estado: se loguea, no se cierra
   39:   EVIDENCIA: 'evidencia',        // mismo telÃ©fono y ventana â‡’ dato para el humano
   40:   NADA: 'nada',
   41: };
   42: 
   43: /** Acuses que prueban la entrega. `read` implica `delivered`. */
   44: const POSITIVOS = new Set(['delivered', 'read']);
   45: 
   46: /**
   47:  * Estados desde los que un acuse positivo PUEDE cerrar.
   48:  * [Kimi, compuerta Fase 3] Un acuse de entrega sobre una fila `failed` es una
   49:  * contradicciÃ³n â€”Meta dijo que fallÃ³ y despuÃ©s que llegÃ³â€”: merece log, no cierre
   50:  * silencioso. Y `delivered` es terminal: repetirlo es un acuse reintregado, no un cambio.
   51:  */
   52: const CERRABLES = new Set(['claimed', 'meta_accepted', 'dudoso']);
   53: 
   54: const soloDigitos = (x) => String(x || '').replace(/\D/g, '');
   55: 
   56: /**
   57:  * Arbitra UN acuse de entrega contra las filas candidatas.
   58:  *
   59:  * @param {{wamid?: string, phone?: string, at?: number|string}} acuse
   60:  * @param {Array<object>} filas  filas de entrega_outbox del mismo tenant
   61:  * @param {{ventanaMs?: number}} [opts]
   62:  * @returns {{veredicto: string, id?: string, motivo: string}}
   63:  */
   64: export function arbitrar(acuse, filas, opts = {}) {
   65:   if (!acuse || typeof acuse !== 'object') return no('acuse_invalido');
   66:   if (!Array.isArray(filas) || !filas.length) return no('sin_candidatas');
   67: 
   68:   const ventana = opts.ventanaMs ?? VENTANA_EVIDENCIA_MS;
   69:   const wamid = String(acuse.wamid || '').trim();
   70:   const tel = soloDigitos(acuse.phone);
   71:   const at = acuse.at ? new Date(acuse.at).getTime() : NaN;
   72: 
   73:   // 1. Prueba exacta. Es lo Ãºnico que cierra.
   74:   if (wamid) {
   75:     const exacta = filas.find((f) => f && String(f.wamid || '').trim() === wamid);
   76:     if (exacta) {
   77:       const est = String(acuse.estado || 'delivered').toLowerCase();
   78: 
   79:       // ðŸ”´ [Kimi, compuerta] EL ACUSE DE FALLO CON wamid CONOCIDO NO PUEDE QUEDAR EN EL
   80:       // LIMBO. Antes caÃ­a en "nada" y la fila se quedaba colgada para siempre: Meta
   81:       // rechazÃ³ el mensaje y el sistema nunca se enteraba. Es exactamente el silencio
   82:       // que este mÃ³dulo viene a eliminar.
   83:       if (est === 'failed') {
   84:         return { veredicto: VEREDICTO.A_FALLIDO, id: exacta.id,
   85:           motivo: `Meta reportÃ³ fallo${acuse.codigo ? ` (cÃ³digo ${acuse.codigo})` : ''}` };
   86:       }
   87: 
   88:       if (!POSITIVOS.has(est)) {
   89:         // `sent` es mÃ¡s dÃ©bil que `meta_accepted`, que ya lo sabemos: no aporta nada.
   90:         return no(`acuse_${est}_no_concluyente`);
   91:       }
   92: 
   93:       // Idempotente: un acuse reintregado sobre una fila ya entregada no es un cambio.
   94:       if (exacta.estado === 'delivered') return no('ya_entregado');
   95: 
   96:       if (!CERRABLES.has(exacta.estado)) {
   97:         return { veredicto: VEREDICTO.CONTRADICCION, id: exacta.id,
   98:           motivo: `llegÃ³ acuse de entrega sobre una fila en estado "${exacta.estado}"` };
   99:       }
  100:       return { veredicto: VEREDICTO.CERRAR, id: exacta.id, motivo: 'wamid_exacto' };
  101:     }
  102:   }
  103: 
  104:   // 2. Sin coincidencia exacta: solo EVIDENCIA, y solo para casos dudosos.
  105:   // Un acuse desconocido a un telÃ©fono que tiene un caso dudoso reciente es una pista
  106:   // fuerte, pero NO una prueba: pudo ser otro mensaje al mismo cliente.
  107:   if (!tel || !Number.isFinite(at)) return no('sin_telefono_u_hora');
  108: 
  109:   const candidatas = filas.filter((f) =>
  110:     f && f.estado === 'dudoso' && soloDigitos(f.phone) === tel && !String(f.wamid || '').trim());
  111: 
  112:   if (!candidatas.length) return no('sin_dudoso_de_ese_telefono');
  113: 
  114:   // La mÃ¡s cercana en el tiempo dentro de la ventana.
  115:   let mejor = null;
  116:   let mejorDist = Infinity;
  117:   let fueraDeVentana = null;
  118:   let fueraDist = Infinity;
  119:   for (const f of candidatas) {
  120:     const ref = f.claimed_at || f.updated_at || f.created_at;
  121:     const t = ref ? new Date(ref).getTime() : NaN;
  122:     if (!Number.isFinite(t)) continue;
  123:     const dist = Math.abs(at - t);
  124:     if (dist <= ventana) {
  125:       if (dist < mejorDist) { mejor = f; mejorDist = dist; }
  126:     } else if (dist < fueraDist) { fueraDeVentana = f; fueraDist = dist; }
  127:   }
  128:   // [Kimi, compuerta] Una pista fuera de ventana NO se tira: los acuses de Meta pueden
  129:   // demorar horas si el cliente tenÃ­a el telÃ©fono apagado. Como la pista no cierra nada,
  130:   // el costo de conservarla es bajo y el de perderla es dejar al dueÃ±o sin informaciÃ³n.
  131:   if (!mejor) {
  132:     if (!fueraDeVentana) return no('sin_candidata_en_el_tiempo');
  133:     return {
  134:       veredicto: VEREDICTO.EVIDENCIA, id: fueraDeVentana.id, debil: true,
  135:       candidatas: candidatas.length,
  136:       motivo: `acuse de entrega a ese telÃ©fono ${Math.round(fueraDist / 60000)} min despuÃ©s del intento (fuera de la ventana habitual)`,
  137:     };
  138:   }
  139: 
  140:   return {
  141:     veredicto: VEREDICTO.EVIDENCIA,
  142:     id: mejor.id,
  143:     // [Kimi] Si habÃ­a varios dudosos del mismo telÃ©fono, se dice cuÃ¡ntos: la pista se le
  144:     // asigna a uno, y el dueÃ±o tiene que saber que habÃ­a otros candidatos.
  145:     candidatas: candidatas.length,
  146:     motivo: `acuse de entrega a ese telÃ©fono ${Math.round(mejorDist / 60000)} min despuÃ©s del intento` +
  147:       (candidatas.length > 1 ? ` â€” ojo: hay ${candidatas.length} casos dudosos de este cliente` : ' â€” probablemente este documento'),
  148:   };
  149: }
  150: 
  151: /** Texto para sumar a la conciliaciÃ³n. NO afirma que llegÃ³: dice quÃ© se sabe. */
  152: export function textoEvidencia(r) {
  153:   if (!r || r.veredicto !== VEREDICTO.EVIDENCIA) return '';
  154:   return `ðŸ“© Pista: ${r.motivo}. Igual conviene mirar el chat antes de reenviar.`;
  155: }
  156: 
  157: function no(motivo) { return { veredicto: VEREDICTO.NADA, motivo }; }
  158: 
  159: export default arbitrar;

