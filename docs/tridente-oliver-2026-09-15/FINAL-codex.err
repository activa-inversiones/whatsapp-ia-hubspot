  107: ];
  108: 
  109: /** El trigger que hace cumplir la invariante a nivel motor. */
  110: const SQL_FUNCION = `
  111:   CREATE OR REPLACE FUNCTION entrega_outbox_guardia() RETURNS trigger AS $$
  112:   BEGIN
  113:     IF NEW.estado = OLD.estado THEN
  114:       RETURN NEW;
  115:     END IF;
  116:     -- La invariante, explÃ­cita y por nombre: lo que duplica clientes.
  117:     IF OLD.estado IN ('claimed','dudoso','meta_accepted','delivered') AND NEW.estado = 'pending' THEN
  118:       RAISE EXCEPTION
  119:         'entrega_outbox: transicion prohibida % -> pending (invariante #778: nunca se reenvia automaticamente algo cuyo resultado no se conoce)',
  120:         OLD.estado;
  121:     END IF;
  122:     IF OLD.estado = 'delivered' THEN
  123:       RAISE EXCEPTION 'entrega_outbox: delivered es terminal (intento: % -> %)', OLD.estado, NEW.estado;
  124:     END IF;
  125:     IF NOT (NEW.estado = ANY (
  126:       CASE OLD.estado
  127:         WHEN 'pending'             THEN ARRAY['claimed']
  128:         WHEN 'claimed'             THEN ARRAY['meta_accepted','dudoso','failed']
  129:         WHEN 'meta_accepted'       THEN ARRAY['delivered','dudoso']
  130:         WHEN 'failed'              THEN ARRAY['reenvio_autorizado']
  131:         WHEN 'dudoso'              THEN ARRAY['delivered','reenvio_autorizado']
  132:         WHEN 'reenvio_autorizado'  THEN ARRAY['claimed']
  133:         ELSE ARRAY[]::text[]
  134:       END)) THEN
  135:       RAISE EXCEPTION 'entrega_outbox: transicion no permitida % -> %', OLD.estado, NEW.estado;
  136:     END IF;
  137:     NEW.updated_at := NOW();
  138:     RETURN NEW;
  139:   END;
  140:   $$ LANGUAGE plpgsql`;
  141: 
  142: const SQL_TRIGGER_DROP = `DROP TRIGGER IF EXISTS entrega_outbox_guardia_trg ON entrega_outbox`;
  143: const SQL_TRIGGER = `
  144:   CREATE TRIGGER entrega_outbox_guardia_trg
  145:     BEFORE UPDATE ON entrega_outbox
  146:     FOR EACH ROW EXECUTE FUNCTION entrega_outbox_guardia()`;
  147: 
  148: /**
  149:  * Crea tabla, Ã­ndices y trigger. Idempotente. NO hace nada si el flag estÃ¡ apagado.
  150:  * @returns {Promise<{ok: boolean, skipped?: boolean, error?: string}>}
  151:  */
  152: export async function ensureOutbox() {
  153:   if (!outboxEnabled()) return { ok: false, skipped: true };
  154:   try {
  155:     await pool.query(SQL_TABLA);
  156:     await pool.query(SQL_UNIQUE);
  157:     for (const sql of SQL_IDX) await pool.query(sql);
  158:     await pool.query(SQL_FUNCION);
  159:     await pool.query(SQL_TRIGGER_DROP);
  160:     await pool.query(SQL_TRIGGER);
  161:     log('tabla, indices y trigger de invariante listos');
  162:     return { ok: true };
  163:   } catch (e) {
  164:     log(`ensureOutbox: ${e.message}`);
  165:     return { ok: false, error: e.message };
  166:   }
  167: }
  168: 
  169: /**
  170:  * Â¿La guardia estÃ¡ REALMENTE puesta en esta base?
  171:  * Existe porque en este repo las migraciones no corren solas y ya hubo drift: un
  172:  * trigger que puede faltar sin que nadie se entere no protege nada. Esto se llama
  173:  * al arrancar y grita si falta.
  174:  */
  175: export async function verificarInvariante() {
  176:   if (!outboxEnabled()) return { ok: false, skipped: true };
  177:   try {
  178:     const { rows } = await pool.query(
  179:       `SELECT 1 FROM pg_trigger WHERE tgname = 'entrega_outbox_guardia_trg' AND NOT tgisinternal LIMIT 1`
  180:     );
  181:     const presente = rows.length > 0;
  182:     if (!presente) {
  183:       console.error('[entregaOutbox] ðŸ”´ EL TRIGGER DE LA INVARIANTE NO EXISTE â€” la proteccion contra duplicados NO esta activa');
  184:     }
  185:     return { ok: presente };
  186:   } catch (e) {
  187:     return { ok: false, error: e.message };
  188:   }
  189: }
  190: 
  191: /**
  192:  * Toma una fila `pending` para enviarla. ATÃ“MICO: la guarda `estado='pending'` hace
  193:  * que dos procesos nunca se lleven la misma fila.
  194:  * Por la invariante, esta es la ÃšNICA transiciÃ³n que puede terminar en un envÃ­o.
  195:  *
  196:  * @param {string} id
  197:  * @param {string} instanceId  uuid del proceso (nunca hostname ni constante: si dos
  198:  *                             instancias comparten id, el fencing deja de servir)
  199:  * @returns {Promise<object|null>} la fila tomada, o null si otro la tomÃ³ primero
  200:  */
  201: export async function reclamar(id, instanceId) {
  202:   if (!outboxEnabled()) return null;
  203:   const { rows } = await pool.query(
  204:     `UPDATE entrega_outbox
  205:         SET estado='claimed', claimed_at=NOW(), instance_id=$2, intentos=intentos+1
  206:       WHERE id=$1 AND estado IN ('pending','reenvio_autorizado')
  207:       RETURNING *`,
  208:     [id, instanceId]
  209:   );
  210:   return rows[0] || null;
  211: }
