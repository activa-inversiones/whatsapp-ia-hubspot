  213: /**
  214:  * Cierra un intento. TODA transiciÃ³n post-envÃ­o pasa por acÃ¡, con fencing:
  215:  * si otro proceso tomÃ³ la fila, este UPDATE no toca nada y devuelve null.
  216:  *
  217:  * @param {{id: string, instanceId: string, intentos: number, estado: string,
  218:  *          wamid?: string, error?: string}} p
  219:  */
  220: export async function cerrarIntento(p) {
  221:   if (!outboxEnabled()) return null;
  222:   const { id, instanceId, intentos, estado, wamid = null, error = null } = p;
  223:   const { rows } = await pool.query(
