   70: 
   71:   const out = [];
   72: 
   73:   for (const f of filas) {
   74:     if (!f || typeof f !== 'object') continue;
   75: 
   76:     switch (f.estado) {
   77:       case 'claimed': {
   78:         const e = edad(f, ahora, 'claimed_at');
   79:         if (!Number.isFinite(e)) break;
