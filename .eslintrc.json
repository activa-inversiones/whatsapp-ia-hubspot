{
  "root": true,
  "env": {
    "node": true,
    "es2024": true
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "extends": [
    "eslint:recommended"
  ],
  "reportUnusedDisableDirectives": true,
  "rules": {
    "no-undef": "error",
    "no-unused-vars": [
      "warn",
      {
        "args": "none",
        "varsIgnorePattern": "^_",
        "caughtErrors": "none"
      }
    ],
    "eqeqeq": [
      "error",
      "always",
      {
        "null": "ignore"
      }
    ],
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": true
      }
    ],
    "no-fallthrough": "error",
    "no-unreachable": "error",
    "no-dupe-keys": "error",
    "no-shadow-restricted-names": "error",
    "no-var": "error",
    "prefer-const": [
      "error",
      {
        "destructuring": "all"
      }
    ],
    "consistent-return": "warn",
    "no-self-compare": "error",
    "no-template-curly-in-string": "warn",
    "no-unmodified-loop-condition": "error",
    "no-unreachable-loop": "error",
    "no-promise-executor-return": "warn",
    "no-constant-binary-expression": "error",
    "no-return-assign": "error",
    "no-throw-literal": "error",
    "no-useless-concat": "warn",
    "no-useless-return": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "no-caller": "error",
    "no-proto": "error",
    "no-extend-native": "error",
    "no-sequences": "error",
    "no-lone-blocks": "warn",
    "radix": "warn",
    "complexity": [
      "warn",
      25
    ],
    "max-depth": [
      "warn",
      5
    ],
    "max-params": [
      "warn",
      6
    ],
    "max-lines-per-function": [
      "warn",
      {
        "max": 200,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 1500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "public/**/*.js"
      ],
      "env": {
        "browser": true,
        "node": false
      },
      "parserOptions": {
        "sourceType": "script"
      }
    },
    {
      "files": [
        "**/*.test.js",
        "**/*.test.mjs"
      ],
      "rules": {
        "max-lines-per-function": "off",
        "max-lines": "off"
      }
    }
  ]
}
